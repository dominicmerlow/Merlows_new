docs/

# Individual automation handlers — excluded from Vercel function count.
# They are imported by api/automation/[...slug].js at runtime (bundled together).
api/automation/approve.js
api/automation/run.js
api/automation/telegram.js
api/automation/telegram-test.js
api/automation/rules/index.js
api/automation/rules/[id].js
api/automation/jobs/index.js
api/automation/jobs/[id].js
api/automation/fetch.js
api/automation/notify.js
api/automation/rule-schema.js
api/automation/job-schema.js

# NOTE: consolidated catch-alls (content/review/core) have NO api/ shims — their
# tests import directly from lib/<area>/handlers/. Do NOT add bracketed shim files
# like `api/content/[id].js`: a `[...]` entry here is read as a glob char-class and
# won't match the literal filename, so the shim would deploy and collide with the
# catch-all (`[...slug].js`). Point tests at lib/ instead.
