# ============================================================
# MERLOWS Content Generator — Environment Variables
# ============================================================
# Copy this file to .env.local and fill in the values.
# .env.local is git-ignored; this file (.env.example) is NOT.
#
# After deployment, register the Telegram webhook once:
#
#   curl "https://api.telegram.org/bot<TELEGRAM_BOT_TOKEN>/setWebhook" \
#     -d "url=https://merlows.vercel.app/api/automation/telegram" \
#     -d "secret_token=<TELEGRAM_WEBHOOK_SECRET>"
# ============================================================


# ------------------------------------------------------------
# Authentication
# ------------------------------------------------------------

# Secret used to sign review JWT tokens and automation approval JWT tokens.
# Generate with: openssl rand -hex 32
JWT_SECRET=


# ------------------------------------------------------------
# Email (Resend)
# ------------------------------------------------------------

# Resend API key for sending transactional emails.
# Obtain at: https://resend.com/api-keys
RESEND_API_KEY=

# From address used for all outbound emails (must be a verified Resend domain).
RESEND_FROM_EMAIL=


# ------------------------------------------------------------
# Application
# ------------------------------------------------------------

# Fully-qualified public URL of the deployed app (no trailing slash).
# Example: https://merlows.vercel.app
NEXT_PUBLIC_APP_URL=


# ------------------------------------------------------------
# GitHub
# ------------------------------------------------------------

# GitHub personal access token with repo read/write access. Two server-side uses:
# (1) lib/content/handlers/gh-data.js — proxies the browser's prompt library, archive
#     (reviews), reports (comparisons) and custom-categories JSON, stored as files in
#     the public repo below. The UI used to hold this token directly (obfuscated in
#     index.html); that copy was revoked, which showed as "Sync failed — using cache".
# (2) lib/automation/fetch.js — fetching source documents.
# Missing → gh-data returns 503. A rejected token (401/403 from GitHub) → gh-data
# returns 502 naming GITHUB_TOKEN.
# Recommended: a fine-grained PAT scoped to Contents read/write on the one repo below only.
# Obtain at: https://github.com/settings/tokens
GITHUB_TOKEN=

# Repo holding the gh-data JSON files (owner/repo). Optional — defaults to
# dominicmerlow/Merlows_new.
GH_DATA_REPO=

# Branch gh-data reads/writes on the repo above. Optional — defaults to ContentGenerator.
GH_DATA_BRANCH=


# ------------------------------------------------------------
# WordPress
# ------------------------------------------------------------

# WordPress site URL (no trailing slash). Example: https://merlows.com
WP_SITE_URL=

# WordPress username (the account used for REST API publishing).
WP_USERNAME=

# WordPress Application Password for the above user.
# Generate at: WordPress Admin → Users → Profile → Application Passwords
WP_APP_PASSWORD=


# ------------------------------------------------------------
# OpenRouter (LLM generation)
# ------------------------------------------------------------

# OpenRouter API key for LLM article generation.
# Obtain at: https://openrouter.ai/keys
OPENROUTER_API_KEY=


# ------------------------------------------------------------
# Cron Security
# ------------------------------------------------------------

# Secret token required to call cron endpoints manually (Bearer auth).
# Generate with: openssl rand -hex 32
CRON_SECRET=


# ------------------------------------------------------------
# Vercel KV (Upstash Redis)
# ------------------------------------------------------------

# REST API URL for the Vercel KV store.
# Found in: Vercel dashboard → Storage → KV → .env.local
KV_REST_API_URL=

# REST API token for the Vercel KV store.
KV_REST_API_TOKEN=

# Full connection URL used by the @vercel/kv SDK.
KV_URL=

# Optional namespace prefix for all KV keys (e.g. "merlows"). Leave blank
# unless you are sharing a single KV store across multiple projects.
KV_PREFIX=


# ------------------------------------------------------------
# Telegram (Automation Module)
# ------------------------------------------------------------

# Telegram Bot API token issued by @BotFather (format: bot<token>).
# Create a bot at: https://t.me/BotFather
TELEGRAM_BOT_TOKEN=

# Telegram chat ID to send alerts to (your channel or group ID).
# Find with: https://t.me/userinfobot
TELEGRAM_CHAT_ID=

# Random 32-character secret used to verify incoming Telegram webhook requests.
# Generate with: openssl rand -hex 16
TELEGRAM_WEBHOOK_SECRET=


# ------------------------------------------------------------
# Congress.gov API (Bibliography)
# ------------------------------------------------------------

# Free API key for searching CRS reports and committee reports.
# Sign up at: https://api.congress.gov/sign-up/
CONGRESS_API_KEY=

# ------------------------------------------------------------
# Zernio (Instagram + TikTok publishing for Merlows News)
# ------------------------------------------------------------

# Zernio API key (Bearer sk_...). Create at: https://zernio.com/dashboard/api-keys
# Store in Vercel as a Sensitive variable. Checked daily by /api/social/connections/check.
ZERNIO_API_KEY=

# ------------------------------------------------------------
# Social autopilot (Instagram + TikTok)
# ------------------------------------------------------------

# Voice-over runs on its OWN OpenRouter key so a runaway voice job cannot drain the
# budget the daily article generation depends on. Falls back to OPENROUTER_API_KEY.
SOCIAL_TTS_API_KEY=

# Vercel Blob read/write token. Voice clips, generated stills and rendered videos are
# stored here, because Zernio fetches them over public HTTPS.
BLOB_READ_WRITE_TOKEN=

# Model that writes the social pack (JSON). Must be reliable at JSON output.
SOCIAL_PACK_MODEL=

# Master switch for the autopilot worker. Set to "off" to stop all social production.
# NOTE: Vercel applies env vars at DEPLOY time, so this only takes effect on a redeploy.
# To stop production NOW, use POST /api/social/autopilot/pause {"paused":true} (admin), which
# sets a KV flag the worker reads every tick.
SOCIAL_AUTOPILOT=

# Model that writes the social pack, and its fallbacks (comma separated).
SOCIAL_PACK_MODEL=
SOCIAL_PACK_FALLBACK_MODELS=

# Generated 9:16 stills per story, on top of the article's hero image (default 2).
SOCIAL_STILLS_PER_PACK=

# The brand's own domain. It is the one link allowed in a caption; everything else is
# rejected, because a caption is posted in the brand's name.
BRAND_SITE_HOST=merlows.com

# ------------------------------------------------------------
# Render service (the merlows-studio Vercel project)
# ------------------------------------------------------------

# Where the Remotion render service lives, e.g. https://merlows-studio.vercel.app
# Rendering runs there because Remotion pushes the video bundle into its sandbox from the
# CALLING function's filesystem — so the caller must be an app with a build step, and this
# app deliberately has none.
RENDER_SERVICE_URL=

# Shared secret for that service. Set the SAME value in both projects. Without it the render
# endpoint refuses every request rather than spending money for anyone who finds it.
RENDER_API_SECRET=
