# ============================================================
# MERLOWS Content Generator — Environment Variables
# ============================================================
# Copy this file to .env.local and fill in the values.
# .env.local is git-ignored; this file (.env.example) is NOT.
#
# After deployment, register the Telegram webhook once:
#
#   curl "https://api.telegram.org/bot<TELEGRAM_BOT_TOKEN>/setWebhook" \
#     -d "url=https://merlows.vercel.app/api/automation/telegram" \
#     -d "secret_token=<TELEGRAM_WEBHOOK_SECRET>"
# ============================================================


# ------------------------------------------------------------
# Authentication
# ------------------------------------------------------------

# Secret used to sign review JWT tokens and automation approval JWT tokens.
# Generate with: openssl rand -hex 32
JWT_SECRET=


# ------------------------------------------------------------
# Email (Resend)
# ------------------------------------------------------------

# Resend API key for sending transactional emails.
# Obtain at: https://resend.com/api-keys
RESEND_API_KEY=

# From address used for all outbound emails (must be a verified Resend domain).
RESEND_FROM_EMAIL=


# ------------------------------------------------------------
# Application
# ------------------------------------------------------------

# Fully-qualified public URL of the deployed app (no trailing slash).
# Example: https://merlows.vercel.app
NEXT_PUBLIC_APP_URL=


# ------------------------------------------------------------
# GitHub
# ------------------------------------------------------------

# GitHub personal access token with repo read/write access. Two server-side uses:
# (1) lib/content/handlers/gh-data.js — proxies the browser's prompt library, archive
#     (reviews), reports (comparisons) and custom-categories JSON, stored as files in
#     the public repo below. The UI used to hold this token directly (obfuscated in
#     index.html); that copy was revoked, which showed as "Sync failed — using cache".
# (2) lib/automation/fetch.js — fetching source documents.
# Missing → gh-data returns 503. A rejected token (401/403 from GitHub) → gh-data
# returns 502 naming GITHUB_TOKEN.
# Recommended: a fine-grained PAT scoped to Contents read/write on the one repo below only.
# Obtain at: https://github.com/settings/tokens
GITHUB_TOKEN=

# Repo holding the gh-data JSON files (owner/repo). Optional — defaults to
# dominicmerlow/Merlows_new.
GH_DATA_REPO=

# Branch gh-data reads/writes on the repo above. Optional — defaults to ContentGenerator.
GH_DATA_BRANCH=


# ------------------------------------------------------------
# WordPress
# ------------------------------------------------------------

# WordPress site URL (no trailing slash). Example: https://merlows.com
WP_SITE_URL=

# WordPress username (the account used for REST API publishing).
WP_USERNAME=

# WordPress Application Password for the above user.
# Generate at: WordPress Admin → Users → Profile → Application Passwords
WP_APP_PASSWORD=


# ------------------------------------------------------------
# OpenRouter (LLM generation)
# ------------------------------------------------------------

# OpenRouter API key for LLM article generation.
# Obtain at: https://openrouter.ai/keys
OPENROUTER_API_KEY=


# ------------------------------------------------------------
# Cron Security
# ------------------------------------------------------------

# Secret token required to call cron endpoints manually (Bearer auth).
# Generate with: openssl rand -hex 32
CRON_SECRET=


# ------------------------------------------------------------
# Vercel KV (Upstash Redis)
# ------------------------------------------------------------

# REST API URL for the Vercel KV store.
# Found in: Vercel dashboard → Storage → KV → .env.local
KV_REST_API_URL=

# REST API token for the Vercel KV store.
KV_REST_API_TOKEN=

# Full connection URL used by the @vercel/kv SDK.
KV_URL=

# Optional namespace prefix for all KV keys (e.g. "merlows"). Leave blank
# unless you are sharing a single KV store across multiple projects.
KV_PREFIX=


# ------------------------------------------------------------
# Telegram (Automation Module + Social Autopilot review)
# ------------------------------------------------------------

# Telegram Bot API token issued by @BotFather. The code adds the "bot" prefix itself when
# calling the Telegram API (https://api.telegram.org/bot<token>/...) — paste only the token
# BotFather gives you, without a leading "bot".
# Create a bot at: https://t.me/BotFather
TELEGRAM_BOT_TOKEN=

# Telegram chat ID to send alerts and social-review approvals to (your DM or group ID).
# Find with: https://t.me/userinfobot
TELEGRAM_CHAT_ID=

# Random secret used to verify incoming Telegram webhook requests (checked against the
# x-telegram-bot-api-secret-token header). Unset -> the webhook returns 503.
# Generate with: openssl rand -hex 16
TELEGRAM_WEBHOOK_SECRET=

# Comma-separated Telegram user ids allowed to press a social-review Approve/Reject button.
# Leave blank to allow anyone in TELEGRAM_CHAT_ID's chat. Find your id with @userinfobot.
TELEGRAM_APPROVER_IDS=

# Social-review gate (lib/social/pack/review.js): "on" holds every rendered pack for review,
# "sensitive" holds only packs the script flagged sensitive, "off" holds nothing. Default "on".
SOCIAL_REVIEW_GATE=

# Minutes an undecided pack waits before it auto-approves. 0 disables auto-approve entirely.
# A pack flagged sensitive never auto-approves regardless of this value. Default 60.
# (Changed 2026-10-01: sensitive packs auto-approve too unless SOCIAL_REVIEW_HOLD_SENSITIVE=on.
# The code default is now off/0 when unset, and the board's switch overrides this once set.)
SOCIAL_REVIEW_AUTO_MINUTES=

# Exactly "on" makes a pack flagged sensitive wait for a person and never auto-approve. Anything
# else, or unset, is off: sensitive packs auto-approve on the same clock as routine ones. A Reject
# always wins. Read from the env only, so changing it needs a redeploy; the board cannot switch it.
SOCIAL_REVIEW_HOLD_SENSITIVE=

# How often (milliseconds) a pack waiting on review is re-checked by the autopilot tick. A
# decision re-queues the pack immediately regardless of this value; it only bounds how soon
# the auto-approve window's own lapse is noticed. Default 1200000 (20 minutes).
SOCIAL_REVIEW_POLL_MS=

# Hours an undecided pack can wait before it is archived: taken out of the queue, every asset
# kept, still approvable from Telegram or the app. Default 72.
SOCIAL_REVIEW_ARCHIVE_HOURS=

# How many times the worker retries sending a pack to Telegram for review before giving up
# and holding it at "review request not delivered". Default 3.
SOCIAL_REVIEW_SEND_ATTEMPTS=

# Minimum tick time (milliseconds) left before a TikTok post is started. TikTok media is
# re-uploaded into Zernio's own storage before the post is created; schedulePost reserves 30s
# of whatever budget it is given for the create-post call that follows, so the default leaves
# the upload 45s. A post that doesn't clear this is deferred to the next tick, not attempted.
# Default 75000 (75 seconds).
SOCIAL_TIKTOK_MIN_BUDGET_MS=


# ------------------------------------------------------------
# Congress.gov API (Bibliography)
# ------------------------------------------------------------

# Free API key for searching CRS reports and committee reports.
# Sign up at: https://api.congress.gov/sign-up/
CONGRESS_API_KEY=

# ------------------------------------------------------------
# Zernio (Instagram + TikTok publishing for Merlows News)
# ------------------------------------------------------------

# Zernio API key (Bearer sk_...). Create at: https://zernio.com/dashboard/api-keys
# Store in Vercel as a Sensitive variable. Checked daily by /api/social/connections/check.
ZERNIO_API_KEY=

# The Merlows News Instagram account and its Zernio profile (not secrets; ids from GET /v1/accounts).
ZERNIO_INSTAGRAM_ACCOUNT_ID=
ZERNIO_PROFILE_ID=

# ------------------------------------------------------------
# Comment-to-DM ("Comment VOICES and we'll DM you the full story"), lib/social/dm
# ------------------------------------------------------------

# Master switch for CREATING automations: exactly "on" to enable, anything else is off.
# Creating an automation switches it on in Zernio (it cannot be created paused), so this
# gates going live. Setting it off stops NEW automations only; existing ones keep answering
# until paused. Applies on the next deploy.
SOCIAL_DM=

# A SEPARATE Zernio key for comment automations (the "merlows-dm" key), created in the
# Merlows News workspace. Sensitive. There is deliberately no fallback to ZERNIO_API_KEY.
ZERNIO_DM_API_KEY=

# Optional: most automations created per 5-minute run (default 5).
SOCIAL_DM_MAX_PER_RUN=

# ------------------------------------------------------------
# Social autopilot (Instagram + TikTok)
# ------------------------------------------------------------

# Voice-over runs on its OWN OpenRouter key so a runaway voice job cannot drain the
# budget the daily article generation depends on. Falls back to OPENROUTER_API_KEY.
SOCIAL_TTS_API_KEY=

# Vercel Blob read/write token. Voice clips, generated stills and rendered videos are
# stored here, because Zernio fetches them over public HTTPS.
BLOB_READ_WRITE_TOKEN=

# Model that writes the social pack (JSON). Must be reliable at JSON output.
SOCIAL_PACK_MODEL=

# Master switch for the autopilot worker. Set to "off" to stop all social production.
# NOTE: Vercel applies env vars at DEPLOY time, so this only takes effect on a redeploy.
# To stop production NOW, use POST /api/social/autopilot/pause {"paused":true} (admin), which
# sets a KV flag the worker reads every tick.
SOCIAL_AUTOPILOT=

# Model that writes the social pack, and its fallbacks (comma separated).
SOCIAL_PACK_MODEL=
SOCIAL_PACK_FALLBACK_MODELS=

# Generated 9:16 stills per story, on top of the article's hero image (default 2).
SOCIAL_STILLS_PER_PACK=

# The brand's own domain. It is the one link allowed in a caption; everything else is
# rejected, because a caption is posted in the brand's name.
BRAND_SITE_HOST=merlows.com

# ------------------------------------------------------------
# Render service (the merlows-studio Vercel project)
# ------------------------------------------------------------

# Where the Remotion render service lives, e.g. https://merlows-studio.vercel.app
# Rendering runs there because Remotion pushes the video bundle into its sandbox from the
# CALLING function's filesystem — so the caller must be an app with a build step, and this
# app deliberately has none.
RENDER_SERVICE_URL=

# Shared secret for that service. Set the SAME value in both projects. Without it the render
# endpoint refuses every request rather than spending money for anyone who finds it.
RENDER_API_SECRET=

# ------------------------------------------------------------
# Social autopilot: per-production cost tracking (lib/social/pack/cost.js)
# ------------------------------------------------------------
# All optional. Each overrides one fallback rate used ONLY when OpenRouter's own
# usage.cost is missing (script, images) or the stage has no bill at all (voice,
# render — those two are always estimated). Read fresh on every call, so a changed
# value takes effect without a redeploy.

# Script fallback when OpenRouter omits usage.cost: USD per million INPUT tokens.
# Default 0.3 (priced off Gemini 2.5 Flash).
SOCIAL_COST_SCRIPT_IN_PER_M=

# Script fallback when OpenRouter omits usage.cost: USD per million OUTPUT tokens.
# Default 2.5.
SOCIAL_COST_SCRIPT_OUT_PER_M=

# Voice-over cost: USD per million characters sent to Fish Audio S2.1 Pro. Default 15
# (published Fish Audio price). A ":free" TTS model is always charged $0.
SOCIAL_COST_TTS_PER_M_CHARS=

# Image fallback when OpenRouter omits usage.cost: USD per image. Default 0.03.
SOCIAL_COST_IMAGE_USD=

# One rendered still (a carousel slide or story card): USD per still. Default 0.0017
# (measured 2026-09-24, ~$0.012 for seven stills).
SOCIAL_COST_STILL_USD=

# A video render: USD per minute its sandbox is alive (wall time, not CPU time — the
# sandbox bills until the next poll stops it, so a slow poll costs money). Default
# 0.0037 (measured 2026-09-24, ~$0.035 over a ~9.5 min-alive sandbox).
SOCIAL_COST_VIDEO_USD_PER_MIN=
