# ============================================================
# MERLOWS Content Generator — Environment Variables
# ============================================================
# Copy this file to .env.local and fill in the values.
# .env.local is git-ignored; this file (.env.example) is NOT.
#
# After deployment, register the Telegram webhook once:
#
#   curl "https://api.telegram.org/bot<TELEGRAM_BOT_TOKEN>/setWebhook" \
#     -d "url=https://merlows.vercel.app/api/automation/telegram" \
#     -d "secret_token=<TELEGRAM_WEBHOOK_SECRET>"
# ============================================================


# ------------------------------------------------------------
# Authentication
# ------------------------------------------------------------

# Secret used to sign review JWT tokens and automation approval JWT tokens.
# Generate with: openssl rand -hex 32
JWT_SECRET=


# ------------------------------------------------------------
# Email (Resend)
# ------------------------------------------------------------

# Resend API key for sending transactional emails.
# Obtain at: https://resend.com/api-keys
RESEND_API_KEY=

# From address used for all outbound emails (must be a verified Resend domain).
RESEND_FROM_EMAIL=


# ------------------------------------------------------------
# Application
# ------------------------------------------------------------

# Fully-qualified public URL of the deployed app (no trailing slash).
# Example: https://merlows.vercel.app
NEXT_PUBLIC_APP_URL=


# ------------------------------------------------------------
# GitHub
# ------------------------------------------------------------

# GitHub personal access token with repo read/write access.
# Used for content storage and source document fetching.
# Obtain at: https://github.com/settings/tokens
GITHUB_TOKEN=


# ------------------------------------------------------------
# WordPress
# ------------------------------------------------------------

# WordPress site URL (no trailing slash). Example: https://merlows.com
WP_SITE_URL=

# WordPress username (the account used for REST API publishing).
WP_USERNAME=

# WordPress Application Password for the above user.
# Generate at: WordPress Admin → Users → Profile → Application Passwords
WP_APP_PASSWORD=


# ------------------------------------------------------------
# OpenRouter (LLM generation)
# ------------------------------------------------------------

# OpenRouter API key for LLM article generation.
# Obtain at: https://openrouter.ai/keys
OPENROUTER_API_KEY=


# ------------------------------------------------------------
# Cron Security
# ------------------------------------------------------------

# Secret token required to call cron endpoints manually (Bearer auth).
# Generate with: openssl rand -hex 32
CRON_SECRET=


# ------------------------------------------------------------
# Vercel KV (Upstash Redis)
# ------------------------------------------------------------

# REST API URL for the Vercel KV store.
# Found in: Vercel dashboard → Storage → KV → .env.local
KV_REST_API_URL=

# REST API token for the Vercel KV store.
KV_REST_API_TOKEN=

# Full connection URL used by the @vercel/kv SDK.
KV_URL=

# Optional namespace prefix for all KV keys (e.g. "merlows"). Leave blank
# unless you are sharing a single KV store across multiple projects.
KV_PREFIX=


# ------------------------------------------------------------
# Telegram (Automation Module)
# ------------------------------------------------------------

# Telegram Bot API token issued by @BotFather (format: bot<token>).
# Create a bot at: https://t.me/BotFather
TELEGRAM_BOT_TOKEN=

# Telegram chat ID to send alerts to (your channel or group ID).
# Find with: https://t.me/userinfobot
TELEGRAM_CHAT_ID=

# Random 32-character secret used to verify incoming Telegram webhook requests.
# Generate with: openssl rand -hex 16
TELEGRAM_WEBHOOK_SECRET=


# ------------------------------------------------------------
# Congress.gov API (Bibliography)
# ------------------------------------------------------------

# Free API key for searching CRS reports and committee reports.
# Sign up at: https://api.congress.gov/sign-up/
CONGRESS_API_KEY=
