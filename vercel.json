{
  "outputDirectory": "public",
  "github": {
    "enabled": false,
    "silent": true
  },
  "functions": {
    "api/automation/[...slug].js": { "maxDuration": 300 },
    "api/social/[...slug].js":     { "maxDuration": 300 },
    "api/content/[...slug].js":    { "maxDuration": 300 },
    "api/core/[...slug].js":       { "maxDuration": 300 }
  },
  "rewrites": [
    { "source": "/api/automation/:slug*", "destination": "/api/automation/[...slug]" },
    { "source": "/api/social/:slug*",     "destination": "/api/social/[...slug]" },
    { "source": "/api/auth/:slug*",       "destination": "/api/auth/[...slug]" },
    { "source": "/api/content",           "destination": "/api/content/[...slug]" },
    { "source": "/api/content/:slug*",    "destination": "/api/content/[...slug]" },
    { "source": "/api/review",            "destination": "/api/review/[...slug]" },
    { "source": "/api/review/:slug*",     "destination": "/api/review/[...slug]" },
    { "source": "/api/publish",           "destination": "/api/core/publish" },
    { "source": "/api/publish/:p*",       "destination": "/api/core/publish/:p*" },
    { "source": "/api/reviewers",         "destination": "/api/core/reviewers" },
    { "source": "/api/reviewers/:p*",     "destination": "/api/core/reviewers/:p*" },
    { "source": "/api/schedule",          "destination": "/api/core/schedule" },
    { "source": "/api/schedule/:p*",      "destination": "/api/core/schedule/:p*" }
  ],
  "crons": [
    { "path": "/api/cron/publish",                  "schedule": "0 8 * * *" },
    { "path": "/api/automation/run",                "schedule": "0 7-12 * * *" },
    { "path": "/api/social/cron",                   "schedule": "0 9 * * *" },
    { "path": "/api/social/autopilot",              "schedule": "*/10 5-21 * * *" },
    { "path": "/api/social/connections/check",      "schedule": "0 6 * * *" },
    { "path": "/api/social/digest",                 "schedule": "45 22 * * *" },
    { "path": "/api/social/dm-sync",                "schedule": "*/5 * * * *" }
  ]
}
